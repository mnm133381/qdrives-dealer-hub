{
  "expo": {
    "name": "Q Drives",
    "slug": "qdrives-dealer-hub",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/brand/qdrives-app-icon.png",
    "scheme": "qdrives",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.qdrives.dealer",
      "associatedDomains": [
        "applinks:qdrives-dealer-hub.preview.emergentagent.com",
        "applinks:qdrives.app"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/qdrives-shield-adaptive.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "pan",
      "package": "app.emergent.qdrivesdealerhub32bd13b5",
      "googleServicesFile": "./google-services.json",
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "versionCode": 9,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "qdrives-dealer-hub.preview.emergentagent.com",
              "pathPrefix": "/lot/"
            },
            {
              "scheme": "https",
              "host": "qdrives.app",
              "pathPrefix": "/lot/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "qdrives"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "androidNavigationBar": {
      "barStyle": "light-content",
      "backgroundColor": "#08080A",
      "visible": "sticky-immersive"
    },
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#08080A",
      "translucent": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/brand/qdrives-shield.png",
      "name": "QD Auctions",
      "shortName": "QD Auctions",
      "themeColor": "#08080A",
      "backgroundColor": "#08080A",
      "display": "standalone",
      "orientation": "portrait",
      "lang": "en-IN",
      "description": "India's trusted B2B wholesale used-car auction platform. Bid live, inspect transparently, settle securely.",
      "startUrl": "/?utm_source=pwa"
    },
    "plugins": [
      "expo-router",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/qdrives-splash.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#08080A"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/qdrives-shield.png",
          "color": "#B91C1C",
          "defaultChannel": "default"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
