{
  "expo": {
    "name": "Q Drives",
    "slug": "qdrives-dealer-hub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/qdrives-app-icon.png",
    "scheme": "qdrives",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.qdrives.dealer"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/qdrives-shield.png",
        "backgroundColor": "#08080A"
      },
      "edgeToEdgeEnabled": false,
      "softwareKeyboardLayoutMode": "pan",
      "package": "in.qdrives.auction",
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "androidNavigationBar": {
      "barStyle": "light-content",
      "backgroundColor": "#050505",
      "visible": "sticky-immersive"
    },
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#050505",
      "translucent": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/brand/qdrives-shield.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/qdrives-splash.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#08080A"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/qdrives-shield.png",
          "color": "#B91C1C",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
